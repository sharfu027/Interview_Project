[Unit]
Description=InterviewOS Spring Boot Core Backend Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=interviewos
Group=interviewos
WorkingDirectory=/opt/interviewos/backend
Environment=SPRING_PROFILES_ACTIVE=prod
Environment=SERVER_PORT=8080
Environment=SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/interviewos
Environment=SPRING_DATASOURCE_USERNAME=interviewos_user
Environment=SPRING_DATASOURCE_PASSWORD=StrongSecureDbPassword2026!
Environment=APP_AI_SERVICE_URL=http://127.0.0.1:8000
Environment=APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
ExecStart=/usr/bin/java -Xms512m -Xmx2048m -XX:+UseG1GC -jar /opt/interviewos/backend/interviewos-backend.jar
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=interviewos-backend

# Security Sandboxing
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
