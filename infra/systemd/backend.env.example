# /etc/interviewos/backend.env
# Permissions: chmod 600 /etc/interviewos/backend.env
# Owner: chown interviewos:interviewos /etc/interviewos/backend.env

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/interviewos
SPRING_DATASOURCE_USERNAME=interviewos_app
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_STRONG_GENERATED_PASSWORD
APP_AI_SERVICE_URL=http://127.0.0.1:8000
JWT_SECRET=REPLACE_WITH_MINIMUM_256_BIT_HEX_OR_BASE64_RANDOM_SECRET
CORS_ALLOWED_ORIGINS=https://interviewos.dev,https://www.interviewos.dev
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=/opt/interviewos/storage/uploads
DEMO_MODE=false
