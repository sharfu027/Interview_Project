# ==============================================================================
# InterviewOS - Environment Configuration Blueprint
# ==============================================================================

# Core Application Settings
APP_NAME=InterviewOS
APP_ENV=production
APP_DEBUG=false
APP_URL=https://interviewos.dev

# Database (PostgreSQL 16)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/interviewos
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# JWT Security
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_REFRESH_EXPIRATION_MS=604800000

# Python FastAPI AI Microservice
APP_AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000
AI_SERVICE_WORKERS=4

# AI LLM Provider Keys (Optional / Fallback Provider Interface Enabled)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Object Storage (AWS S3 or MinIO)
STORAGE_PROVIDER=LOCAL
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=interviewos-recordings

# Redis (Caching & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Frontend
VITE_API_URL=http://localhost:8080/api/v1
