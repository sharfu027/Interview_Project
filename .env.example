# ==============================================================================
# InterviewOS — Environment Configuration Blueprint (Production Ready)
# ==============================================================================

# Core Application Settings
APP_NAME=InterviewOS
APP_ENV=production
APP_DEBUG=false
APP_URL=https://interviewos.dev

# Feature Flags & Demo Mode Control
# When set to false, disables automatic insertion of dummy jobs, sample applications,
# canned weaknesses, and forces live provider integrations.
DEMO_MODE=false
VITE_DEMO_MODE=false

# ------------------------------------------------------------------------------
# Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/interviewos
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# ------------------------------------------------------------------------------
# JWT Security & Tenant Isolation
# ------------------------------------------------------------------------------
# Must be at least 256 bits (64 hex characters) in production
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------------
# Python FastAPI AI Microservice
# ------------------------------------------------------------------------------
APP_AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_WORKERS=4
BACKEND_SECRET_KEY=interviewos-internal-secret-token

# ------------------------------------------------------------------------------
# AI LLM Provider Configuration
# Supported AI_PROVIDER values: openai | anthropic | gemini | mock
# ------------------------------------------------------------------------------
AI_PROVIDER=openai
AI_REQUEST_TIMEOUT_SECONDS=30

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Speech-to-Text (STT) Provider Configuration
# Supported STT_PROVIDER values: whisper | deepgram | faster-whisper-local | mock
# ------------------------------------------------------------------------------
STT_PROVIDER=whisper
DEEPGRAM_API_KEY=

# ------------------------------------------------------------------------------
# Live Job Market Feed Provider
# Supported JOB_PROVIDER values: adzuna | jsearch | database
# ------------------------------------------------------------------------------
JOB_PROVIDER=adzuna
ADZUNA_APP_ID=
ADZUNA_API_KEY=
RAPIDAPI_KEY=

# ------------------------------------------------------------------------------
# Code Execution Sandbox Engine (Coding Lab)
# Supported CODE_EXECUTION_ENGINE values: judge0 | piston | mock
# ------------------------------------------------------------------------------
CODE_EXECUTION_ENGINE=judge0
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=

# ------------------------------------------------------------------------------
# Cloud Object Storage (Resumes & Audio/Video Recordings)
# Supported STORAGE_PROVIDER values: S3 | LOCAL
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=LOCAL
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=interviewos-recordings

# ------------------------------------------------------------------------------
# Redis (Caching, Session State & Rate Limiting)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Frontend Client Environment
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8080/api/v1
